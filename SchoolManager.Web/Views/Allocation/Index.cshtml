@using System.Globalization
@model SchoolManager.Application.ViewModels.Allocation.AllocationVm
@{
    ViewData["Title"] = "Dodatek Motywacyjny";
    var pl = CultureInfo.GetCultureInfo("pl-PL");
    decimal remaining = Model.Budget - Model.Assigned;
    decimal usage = Model.Budget == 0 ? 0 : Math.Min(100m, (Model.Assigned / Model.Budget) * 100m);
    string progressClass = usage < 80 ? "bg-success" : usage <= 100 ? "bg-warning" : "bg-danger";
}

<form id="allocation-form">
    @Html.AntiForgeryToken()
    <input type="hidden" id="teacherSalaryId" value="@Model.TeacherSalaryId" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Przyznawanie dodatków motywacyjnych (Semestr: @Model.SemesterName)</h2>
        <span class="badge bg-secondary">@Model.SchoolYearStart @Model.SemesterName</span>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <strong>Budżet: </strong>
            <span id="budget-amount" data-value="@Model.Budget.ToString(CultureInfo.InvariantCulture)">
                @Model.Budget.ToString("C2", pl)
            </span>
        </div>
        <div class="col-md-4">
            <strong>Przydzielone: </strong>
            <span id="assigned-amount" data-value="@Model.Assigned.ToString(CultureInfo.InvariantCulture)">
                @Model.Assigned.ToString("C2", pl)
            </span>
        </div>
        <div class="col-md-4">
            <strong>Pozostało: </strong>
            <span id="remaining-amount">
                @remaining.ToString("C2", pl)
            </span>
        </div>
    </div>

    <div class="progress mb-3">
        <div id="progress-bar" class="progress-bar @progressClass" role="progressbar"
             style="width: @usage.ToString("F1", CultureInfo.InvariantCulture)%">
            <span id="usage-percent">@usage.ToString("F1", CultureInfo.InvariantCulture)</span>%
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Nauczyciel</th>
                    <th>Pensja zasadnicza (brutto)</th>
                    <th>Procent</th>
                    <th>Kwota dodatku (brutto)</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var row = Model.Items[i];
                    <tr class="teacher-row" data-teacher-id="@row.TeacherId" data-base-salary="@row.BaseSalary.ToString(CultureInfo.InvariantCulture)">
                        <td>
                            @row.TeacherName
                            <input type="hidden" name="Items[@i].TeacherId" value="@row.TeacherId" />
                        </td>
                        <td>@row.BaseSalary.ToString("C2", pl)</td>
                        <td>
                            <input type="number" class="form-control form-control-sm percent-input" name="Items[@i].Percent" value="@row.Percent" min="0" max="100" step="1" @(Model.IsApproved ? "disabled" : "") />
                        </td>
                        <td class="amount-cell">@row.Amount.ToString("C2", pl)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 p-3 border-top bg-white" style="position: sticky; bottom: 0; z-index: 10;">
        <div>
            Suma: <span id="summary-assigned">@Model.Assigned.ToString("C2", pl)</span> /
            Budżet: <span id="summary-budget">@Model.Budget.ToString("C2", pl)</span>
            (<span id="summary-percent">@usage.ToString("F1", CultureInfo.InvariantCulture)</span>%)
            Pozostało: <span id="summary-remaining">@remaining.ToString("C2", pl)</span>
        </div>
        <div id="validation-message" role="alert" class="@(remaining >= 0 ? "text-success" : "text-danger")">
            @(remaining >= 0 ? $"OK, pozostało {remaining.ToString("C2", pl)}" : $"Przekroczono budżet o {(Math.Abs(remaining)).ToString("C2", pl)}")
        </div>
    </div>

    <div class="mt-3">
        <button type="button" id="btn-save" class="btn btn-primary me-2" @(Model.IsApproved ? "disabled" : "")>Zapisz szkic</button>
        <button type="button" id="btn-approve" class="btn btn-success me-2" @(Model.IsApproved || remaining < 0 ? "disabled" : "")>Zatwierdź</button>
        <button type="button" id="btn-reset7" class="btn btn-secondary me-2" @(Model.IsApproved ? "disabled" : "")>Reset do 7%</button>
        <a class="btn btn-outline-secondary me-2" href="@Url.Action("ExportPdf", "Allocation", new { arkuszId = Model.TeacherSalaryId })">Eksport do PDF</a>
        <a class="btn btn-outline-secondary" href="@Url.Action("ExportExcel", "Allocation", new { arkuszId = Model.TeacherSalaryId })">Eksport do Excel</a>
    </div>
</form>

@section Scripts {
    <script>
        const budget = parseFloat($('#budget-amount').data('value')) || 0;
        let isApproved = @(Model.IsApproved ? "true" : "false");

        function round2HalfUp(x) {
            const sign = x < 0 ? -1 : 1;
            return sign * Math.round(Math.abs(x) * 100) / 100;
        }

        function formatPLN(x) {
            return new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(x);
        }

        function updateSummary(assigned, remaining) {
            const usage = budget === 0 ? 0 : Math.min(100, (assigned / budget) * 100);
            $('#assigned-amount, #summary-assigned').text(formatPLN(assigned));
            $('#remaining-amount, #summary-remaining').text(formatPLN(remaining));
            $('#usage-percent, #summary-percent').text(usage.toFixed(1));
            $('#progress-bar').css('width', usage.toFixed(1) + '%');
            $('#progress-bar').removeClass('bg-success bg-warning bg-danger');
            if (usage < 80) {
                $('#progress-bar').addClass('bg-success');
            } else if (usage <= 100) {
                $('#progress-bar').addClass('bg-warning');
            } else {
                $('#progress-bar').addClass('bg-danger');
            }
            const vm = $('#validation-message');
            if (remaining >= 0) {
                vm.removeClass('text-danger').addClass('text-success').text('OK, pozostało ' + formatPLN(remaining));
            } else {
                vm.removeClass('text-success').addClass('text-danger').text('Przekroczono budżet o ' + formatPLN(-remaining));
            }
            if (remaining >= 0 && !isApproved) {
                $('#btn-approve').prop('disabled', false);
            } else {
                $('#btn-approve').prop('disabled', true);
            }
        }

        function recalc() {
            let assigned = 0;
            $('.teacher-row').each(function () {
                const baseSalary = parseFloat($(this).data('base-salary')) || 0;
                const percent = parseInt($(this).find('.percent-input').val()) || 0;
                const amount = round2HalfUp((percent / 100) * baseSalary);
                assigned += amount;
                $(this).find('.amount-cell').text(formatPLN(amount));
            });
            const remaining = round2HalfUp(budget - assigned);
            updateSummary(assigned, remaining);
        }

        function collectItems() {
            const items = [];
            $('.teacher-row').each(function () {
                const teacherId = $(this).data('teacher-id');
                const percent = parseInt($(this).find('.percent-input').val()) || 0;
                items.push({ teacherId: teacherId, percent: percent });
            });
            return items;
        }

        $('.percent-input').on('input', function () {
            let v = parseInt($(this).val(), 10);
            if (isNaN(v)) v = 0;
            if (v < 0) v = 0;
            if (v > 100) v = 100;
            $(this).val(v);
            recalc();
        }).on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
            }
        });

        $('#btn-reset7').on('click', function () {
            $('.percent-input').val(7);
            recalc();
        });

        function showAlert(message) {
            alert(message);
        }

        $('#btn-save').on('click', function () {
            const token = $('input[name="__RequestVerificationToken"]').val();
            const data = {
                teacherSalaryId: $('#teacherSalaryId').val(),
                items: collectItems()
            };
            $.ajax({
                url: '/Allocation/SaveDraft',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: { 'RequestVerificationToken': token },
                success: function (res) {
                    if (res) {
                        updateSummary(res.sum, res.remaining);
                        showAlert(res.message);
                    }
                },
                error: function () {
                    showAlert('Błąd zapisu');
                }
            });
        });

        $('#btn-approve').on('click', function () {
            const token = $('input[name="__RequestVerificationToken"]').val();
            const data = {
                teacherSalaryId: $('#teacherSalaryId').val()
            };
            $.ajax({
                url: '/Allocation/Approve',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: { 'RequestVerificationToken': token },
                success: function (res) {
                    if (res && res.ok) {
                        isApproved = true;
                        $('.percent-input').prop('disabled', true);
                        $('#btn-save, #btn-reset7, #btn-approve').prop('disabled', true);
                        updateSummary(res.sum, res.remaining);
                        showAlert(res.message);
                    } else if (res) {
                        showAlert(res.message);
                    }
                },
                error: function () {
                    showAlert('Błąd zatwierdzania');
                }
            });
        });

        // initial calculation
        recalc();
    </script>
}